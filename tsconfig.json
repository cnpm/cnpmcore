{
  "extends": "@eggjs/tsconfig",
  "compilerOptions": {
    "strict": true,
    "erasableSyntaxOnly": false,
    "types": [ "node", "vitest/globals" ],
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitAny": true,
    "declaration": false,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
  }
}
